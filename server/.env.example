# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/QuickShow

# OMDb API key (used to search/import movie data) — get one free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Currency code used for Stripe checkout line items (ISO 4217, e.g. INR, USD)
CURRENCY=INR

# Clerk (authentication)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Inngest (background jobs / Clerk user sync)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Stripe payment gateway — test mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Get this after creating a webhook endpoint (see README) pointing to /api/stripe
STRIPE_WEBHOOK_SECRET=

# --- Admin login (standalone, not Clerk) ---
# Change these before going live! This is a simple username/password login
# used only for the /admin dashboard, completely separate from Clerk.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Any long random string — used to sign admin login sessions.
ADMIN_JWT_SECRET=
